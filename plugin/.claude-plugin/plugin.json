{
  "name": "posturanet",
  "displayName": "PosturaNet",
  "version": "0.1.0",
  "description": "Evidence-backed Terraform fixes for AWS security groups, S3 public access and IAM least privilege, and a contract check on every security group, S3 and IAM policy edit. Read-only in AWS. Needs the posturanet CLI: pip install \"posturanet[mcp]\".",
  "author": { "name": "PosturaNet", "url": "https://posturanet.com" },
  "homepage": "https://posturanet.com",
  "repository": "https://github.com/Mihirajmera/posturanet",
  "license": "FSL-1.1-ALv2",
  "keywords": ["aws", "terraform", "security", "remediation", "security-hub", "iam", "s3"],
  "mcpServers": {
    "posturanet": { "command": "posturanet", "args": ["mcp"] }
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "posturanet hook claude-code", "timeout": 30 }]
      }
    ]
  }
}
