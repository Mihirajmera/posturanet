{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Synthetic IAM stack for PosturaNet tests.",
  "Resources": {
    "AppPolicy": {
      "Type": "AWS::IAM::ManagedPolicy",
      "Properties": {
        "ManagedPolicyName": "app",
        "PolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Sid": "App",
              "Effect": "Allow",
              "Action": [
                "ec2:*",
                "logs:*"
              ],
              "Resource": "*"
            }
          ]
        }
      }
    }
  }
}
